    "@noble/hashes": "2.4.0",
    "opencc-js": "1.4.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.41",
    "@types/node": "^24.0.0",
    "playwright": "^1.61.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
